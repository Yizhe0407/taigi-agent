# 最小可跑設定（CLI / chat API 必填）
# LLM（OpenAI-compatible，預設 Ollama）
LLM_BASE_URL=http://your-ollama-host:11434/v1
LLM_MODEL=your-model-name
LLM_API_KEY=ollama
# 單次 LLM HTTP attempt timeout；SDK 內建 retry 已關閉，應用層最多嘗試 3 次。
# LLM_CONNECT_TIMEOUT_SECONDS=5
# LLM_READ_TIMEOUT_SECONDS=60
# LLM_WRITE_TIMEOUT_SECONDS=15
# LLM_POOL_TIMEOUT_SECONDS=5

# Kiosk 站牌設定透過後台 UI 管理（/admin），不需在此設定。
# 預設：雲林科技大學（回程）。設定存於 .agent_state/kiosk_config.json。
# 管理寫入採 fail-closed；請設定高熵 token，前端只保存在目前瀏覽器 session。
ADMIN_TOKEN=replace-with-a-long-random-secret

# API 內建單 worker token-bucket 限流；多 worker / 多機部署仍應在 gateway 限流。
# RATE_LIMIT_ENABLED=true

# 下面設定依功能選填；沒開對應功能時可先保持註解。

# 可觀測性（選填）：OpenTelemetry OTLP/HTTP endpoint
# 目前預設觀測後端選 SigNoz；self-host 在本機時 OTLP/HTTP 預設可用 4318
# 同一組變數涵蓋 trace、metric、log 三種訊號，不用分開設定
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=taigi-bus-agent

# 路線規劃 / 公共自行車（選填）
# TDX credentials 只在選用 tdx provider、更新 GTFS 時需要；moovo_web 不需要。
# TDX_CLIENT_ID=
# TDX_CLIENT_SECRET=

# 公共自行車站點/即時可借資料快取秒數（選填，預設 60）
# BIKE_CACHE_TTL_SECONDS=60

# OTP route planning provider（選填，預設本機 Docker service）
# OTP_BASE_URL=http://localhost:8081
# YUNLIN_STOP_INDEX_PATH=otp/data/yunlin-stop-index.json
# EBUS_ROUTE_INDEX_PATH=.agent_state/ebus-route-index.json

# 語音功能（選填）
# 公網 WebRTC 必填：Cloudflare Realtime TURN persistent key 只存在 backend。
# Browser 只會取得 /api/voice/ice-servers 回傳的短效 credentials。
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_KEY_API_TOKEN=
# CLOUDFLARE_TURN_TTL_SECONDS=86400

# ASR（Breeze ASR，OpenAI /v1/audio/transcriptions 格式）
# ASR_BASE_URL=https://asr.yizhe.dev
# ASR_MODEL=breeze-asr-26
# ASR_API_KEY=

# Cloudflare Access Service Token（當三個模型 endpoint 受 Access 保護時填寫）
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# TTS（OpenAI /v1/audio/speech 格式，漢羅 → Taibun → Piper TTS）
# TTS_BASE_URL=https://tts.yizhe.dev
# TTS_MODEL=taigi_text_epoch3419
# TTS_VOICE=taigi_text_epoch3419
# TTS_API_KEY=

# Route planning API 若要讓另一個 frontend dev server 跨來源呼叫再設定
# API_CORS_ORIGINS=http://127.0.0.1:5173
# Bike provider priority, comma-separated (first success wins).
# Built-ins: tdx, moovo_web. Add a registered provider name to switch/extend.
# BIKE_PROVIDER_ORDER=tdx,moovo_web

# Bus provider chain, comma-separated (first usable answer wins).
# Built-ins: taiwanbus, tdx, ebus. Add a registered provider name to switch/extend.
# taiwanbus needs no credentials and is the primary; keep tdx out of this chain
# to preserve its quota for GTFS updates / bike provider unless taiwanbus is down.
# BUS_PROVIDER_ORDER=taiwanbus
# Where the ebus provider persists its stop→route index (only used when 'ebus' is in the chain).
# EBUS_ROUTE_INDEX_PATH=.agent_state/ebus-route-index.json
